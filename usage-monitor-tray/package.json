{
  "name": "cp-ai-monitor-tray",
  "productName": "AI Monitor",
  "version": "0.1.0",
  "private": true,
  "description": "System tray monitor for Claude, Codex and Grok usage limits",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "build:renderer": "vite build",
    "build:main": "esbuild src/main/main.ts src/main/preload.ts --bundle --platform=node --format=cjs --external:electron --outdir=dist-electron --out-extension:.js=.cjs",
    "build": "tsc --noEmit && npm run build:renderer && npm run build:main",
    "start": "npm run build && electron .",
    "package": "npm run build && node scripts/package.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "electron": "45.5.0",
    "@electron/packager": "^18.4.4",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0",
    "vite": "^5.4.0",
    "@vitejs/plugin-react": "^4.3.0",
    "vitest": "^2.1.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/node": "^20.0.0"
  },
  "dependencies": {
    "@mantine/core": "^7.17.0",
    "@mantine/hooks": "^7.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
